# ========================================================
# MERN MCQ Quiz Platform - Environment Variables
# For Vercel: Add these in Project Settings -> Environment Variables
# ========================================================

# MongoDB Atlas Connection URI (Required for Vercel deployment)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/mern_quiz_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/mern_quiz_db?retryWrites=true&w=majority

# Node Environment
NODE_ENV=production

# (Optional) Port for local server runtime
PORT=5000

# (Optional) Custom frontend URL if deploying client on a separate custom domain
# CLIENT_URL=https://your-custom-domain.com
